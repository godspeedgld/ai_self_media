 "groups": [
  {
   "start": 0.11,
   "end": 0.4,
   "text": "今天"
  },
  {
   "start": 0.6,
   "end": 2.05,
   "text": "我们来讲讲鱼,"
  },
  {
   "start": 2.32,
   "end": 3.45,
   "text": "我们都说鱼有七秒的"
  },
  {
   "start": 3.45,
   "end": 4.11,
   "text": "记忆,"
  },
  {
   "start": 4.11,
   "end": 5,
   "text": "鱼真的有七秒记忆吗?"
  },
  {
   "start": 5.23,
   "end": 6.08,
   "text": "不知道,"
  },
  {
   "start": 6.08,
   "end": 8.31,
   "text": "但是养了鱼,"
  },
  {
   "start": 8.31,
   "end": 9.56,
   "text": "养了鱼之后发现这个"
  },
  {
   "start": 9.56,
   "end": 10.88,
   "text": "鱼啊"
  },
  {
   "start": 11.27,
   "end": 11.82,
   "text": "时间,"
  },
  {
   "start": 11.82,
   "end": 13.75,
   "text": "我养鱼喂食喂多了"
  },
  {
   "start": 13.75,
   "end": 14.42,
   "text": "之后,"
  },
  {
   "start": 14.42,
   "end": 16.56,
   "text": "每次我靠近鱼缸,"
  },
  {
   "start": 16.56,
   "end": 18.16,
   "text": "鱼又会跑过来"
  },
  {
   "start": 18.34,
   "end": 19.25,
   "text": "因为我们养的那个"
  },
  {
   "start": 19.28,
   "end": 19.53,
   "text": "鱼"
  },
  {
   "start": 19.78,
   "end": 21.48,
   "text": "缸不是那种专业鱼缸"
  },
  {
   "start": 21.48,
   "end": 21.7,
   "text": "嘛,"
  },
  {
   "start": 21.7,
   "end": 22.76,
   "text": "还要换水换气没有,"
  },
  {
   "start": 22.76,
   "end": 23.25,
   "text": "我们就是搞了个"
  },
  {
   "start": 23.25,
   "end": 23.67,
   "text": "缸子,"
  },
  {
   "start": 23.67,
   "end": 24.88,
   "text": "然后养了条鱼,"
  },
  {
   "start": 24.88,
   "end": 25.48,
   "text": "对不对?"
  },
  {
   "start": 25.59,
   "end": 26.94,
   "text": "然后我们发现每次靠"
  },
  {
   "start": 26.94,
   "end": 27.88,
   "text": "近它的时候,"
  },
  {
   "start": 27.88,
   "end": 28.98,
   "text": "它的那个小鱼就"
  },
  {
   "start": 29.08,
   "end": 30.07,
   "text": "跑上来了它本来"
  },
  {
   "start": 30.28,
   "end": 31.26,
   "text": "可能在缸子底下"
  },
  {
   "start": 31.53,
   "end": 32.44,
   "text": "就跑上来了,"
  },
  {
   "start": 32.44,
   "end": 33.88,
   "text": "而且非常非常费力卖"
  },
  {
   "start": 33.97,
   "end": 34.75,
   "text": "力的去表演"
  },
  {
   "start": 35,
   "end": 36.6,
   "text": "它的这个技能而且把"
  },
  {
   "start": 36.73,
   "end": 36.99,
   "text": "头,"
  },
  {
   "start": 36.99,
   "end": 38.26,
   "text": "就是以前鱼是平着"
  },
  {
   "start": 38.53,
   "end": 39.06,
   "text": "游的,"
  },
  {
   "start": 39.07,
   "end": 40.49,
   "text": "它能竖得起来,"
  },
  {
   "start": 40.49,
   "end": 40.88,
   "text": "哇,"
  },
  {
   "start": 40.97,
   "end": 41.76,
   "text": "那在水面上一张"
  },
  {
   "start": 42,
   "end": 43.23,
   "text": "一只因为我们喂食的时候"
  },
  {
   "start": 43.23,
   "end": 44.69,
   "text": "都是从鱼缸顶上"
  },
  {
   "start": 44.69,
   "end": 46.54,
   "text": "去喂食的嘛所以"
  },
  {
   "start": 46.81,
   "end": 48.26,
   "text": "如果鱼真的只有七秒"
  },
  {
   "start": 48.26,
   "end": 49.52,
   "text": "的记忆,"
  },
  {
   "start": 49.56,
   "end": 51.18,
   "text": "它怎么能记住鱼食是"
  },
  {
   "start": 51.18,
   "end": 52.21,
   "text": "从上面来的呢?"
  },
  {
   "start": 52.32,
   "end": 53.43,
   "text": "也就是说它刚吃完这个"
  },
  {
   "start": 53.43,
   "end": 54.26,
   "text": "鱼食之后,"
  },
  {
   "start": 54.53,
   "end": 55.75,
   "text": "估计七秒之后,"
  },
  {
   "start": 55.75,
   "end": 56.74,
   "text": "它就忘了鱼食从"
  },
  {
   "start": 56.74,
   "end": 58.12,
   "text": "哪里来了所以鱼只有"
  },
  {
   "start": 58.12,
   "end": 59.61,
   "text": "七秒这个记忆,"
  },
  {
   "start": 59.61,
   "end": 61.21,
   "text": "我觉得这个应该是"
  },
  {
   "start": 61.21,
   "end": 62.49,
   "text": "个谣言,"
  },
  {
   "start": 62.49,
   "end": 62.75,
   "text": "应该"
  },
  {
   "start": 63,
   "end": 64.41,
   "text": "不对的至少我们养的"
  },
  {
   "start": 64.41,
   "end": 65.21,
   "text": "那个鱼"
  }
 ]
}