# === Application ===
APP_ENV=development
APP_SECRET_KEY=change-me-to-random-string
APP_DEBUG=true

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_self_media

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === File Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

# === AI Models (OpenAI-compatible) ===
# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱 GLM
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Default model
DEFAULT_TEXT_MODEL=openai:qwen-max
DEFAULT_IMAGE_MODEL=dashscope:wanx-v2

# === Web Search ===
TAVILY_API_KEY=tvly-your-tavily-key

# === Browser Automation ===
BROWSER_HEADLESS=true
BROWSER_SESSION_DIR=./data/browser_sessions

# === LangSmith (optional, for tracing) ===
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=ai-self-media
